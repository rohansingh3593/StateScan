# Application PostgreSQL database settings for a standalone PostgreSQL container.
# Use 127.0.0.1 when running FastAPI locally on the host.
# Use host.docker.internal when running FastAPI in Docker Compose on Linux/Mac/Windows.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=app_db
DB_USER=postgres
DB_PASSWORD=postgres

# Dedicated pytest PostgreSQL database settings.
TEST_DB_HOST=127.0.0.1
TEST_DB_PORT=5432
TEST_DB_NAME=test_db
TEST_DB_USER=postgres
TEST_DB_PASSWORD=postgres

# Host port used by the standalone PostgreSQL docker run command.
DB_HOST_PORT=5432
